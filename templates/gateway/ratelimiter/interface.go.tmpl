package ratelimiter

import (
	"context"
	"net/http"
	"strings"
)

// RateLimiter defines the interface for rate limiting implementations
type RateLimiter interface {
	// Allow checks if a request should be allowed
	// Returns true if the request is allowed, false otherwise
	Allow(ctx context.Context, key string) (bool, error)

	// AllowN checks if n requests should be allowed
	AllowN(ctx context.Context, key string, n int) (bool, error)

	// Reset resets the rate limit for a key
	Reset(ctx context.Context, key string) error

	// GetStats returns current rate limit statistics for a key
	GetStats(ctx context.Context, key string) (*Stats, error)

	// Close releases resources (stops cleanup goroutines, closes connections)
	Close()
}

// Stats holds rate limit statistics
type Stats struct {
	Key       string
	Remaining int
	Total     int
	ResetAt   int64
}

// KeyFunc extracts the rate limiting key from a request
type KeyFunc func(*http.Request) string

// DefaultKeyFunc keys on the client IP. It is only a fallback for callers that
// do not configure user-level keying (see NewUserKeyFunc) — generated services
// key on the authenticated user, leaving IP-based limiting to the reverse proxy.
// It prefers X-Real-IP (set by a trusted proxy) over the spoofable
// X-Forwarded-For, then falls back to RemoteAddr.
func DefaultKeyFunc(r *http.Request) string {
	if xri := r.Header.Get("X-Real-IP"); xri != "" {
		return strings.TrimSpace(xri)
	}
	return r.RemoteAddr
}

// ErrRateLimited is returned when a request is rate limited
type ErrRateLimited struct {
	Key      string
	RetryAt  int64
}

func (e *ErrRateLimited) Error() string {
	return "rate limit exceeded for: " + e.Key
}

// IsRateLimited checks if an error is a rate limit error
func IsRateLimited(err error) bool {
	_, ok := err.(*ErrRateLimited)
	return ok
}
