package db

import (
	"context"
	"errors"

	"{{.ModuleName}}/internals/types"

	"github.com/jackc/pgx/v5"
)

// sessionColumns is the canonical column list/order for session scans.
const sessionColumns = "id, user_id, refresh_token, token_family, user_agent, ip, expires_at, created_at"

// scanSession scans one session row in sessionColumns order.
func scanSession(scan func(dest ...any) error) (*types.Session, error) {
	session := &types.Session{}
	err := scan(
		&session.ID,
		&session.UserID,
		&session.RefreshToken,
		&session.TokenFamily,
		&session.UserAgent,
		&session.IP,
		&session.ExpiresAt,
		&session.CreatedAt,
	)
	return session, err
}

// CreateSession creates a new session
func (c *PostgresClient) CreateSession(ctx context.Context, session *types.Session) error {
	_, err := c.pool.Exec(ctx, `
		INSERT INTO sessions (id, user_id, refresh_token, token_family, user_agent, ip, expires_at, created_at)
		VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
	`,
		session.ID,
		session.UserID,
		session.RefreshToken,
		session.TokenFamily,
		session.UserAgent,
		session.IP,
		session.ExpiresAt,
		session.CreatedAt,
	)
	return err
}

// GetSessionByID retrieves an active (unconsumed) session by ID
func (c *PostgresClient) GetSessionByID(ctx context.Context, id string) (*types.Session, error) {
	session, err := scanSession(c.pool.QueryRow(ctx, `
		SELECT `+sessionColumns+`
		FROM sessions
		WHERE id = $1 AND consumed_at IS NULL
	`, id).Scan)

	if errors.Is(err, pgx.ErrNoRows) {
		return nil, errors.New("session not found")
	}
	if err != nil {
		return nil, err
	}

	return session, nil
}

// GetSessionByRefreshToken retrieves an active (unconsumed) session by refresh token
func (c *PostgresClient) GetSessionByRefreshToken(ctx context.Context, token string) (*types.Session, error) {
	session, err := scanSession(c.pool.QueryRow(ctx, `
		SELECT `+sessionColumns+`
		FROM sessions
		WHERE refresh_token = $1 AND consumed_at IS NULL
	`, token).Scan)

	if errors.Is(err, pgx.ErrNoRows) {
		return nil, errors.New("session not found")
	}
	if err != nil {
		return nil, err
	}

	return session, nil
}

// GetUserSessions retrieves all active (unconsumed) sessions for a user
func (c *PostgresClient) GetUserSessions(ctx context.Context, userID string) ([]*types.Session, error) {
	rows, err := c.pool.Query(ctx, `
		SELECT `+sessionColumns+`
		FROM sessions
		WHERE user_id = $1 AND consumed_at IS NULL
		ORDER BY created_at DESC
	`, userID)
	if err != nil {
		return nil, err
	}
	defer rows.Close()

	var sessions []*types.Session
	for rows.Next() {
		session, err := scanSession(rows.Scan)
		if err != nil {
			return nil, err
		}
		sessions = append(sessions, session)
	}

	return sessions, rows.Err()
}

// ConsumeSessionByRefreshToken atomically marks a session as consumed by its
// refresh token and returns the consumed session. The single UPDATE ... WHERE
// consumed_at IS NULL guarantees only one concurrent refresh wins (no TOCTOU);
// a replay of an already-consumed token returns "session not found".
func (c *PostgresClient) ConsumeSessionByRefreshToken(ctx context.Context, token string) (*types.Session, error) {
	session, err := scanSession(c.pool.QueryRow(ctx, `
		UPDATE sessions
		SET consumed_at = NOW()
		WHERE refresh_token = $1 AND consumed_at IS NULL
		RETURNING `+sessionColumns+`
	`, token).Scan)

	if errors.Is(err, pgx.ErrNoRows) {
		return nil, errors.New("session not found")
	}
	if err != nil {
		return nil, err
	}

	return session, nil
}

// GetTokenFamilyByConsumedRefreshToken returns the token family of an
// already-consumed refresh token, used to detect refresh-token reuse.
func (c *PostgresClient) GetTokenFamilyByConsumedRefreshToken(ctx context.Context, token string) (string, error) {
	var family string
	err := c.pool.QueryRow(ctx, `
		SELECT token_family FROM sessions
		WHERE refresh_token = $1 AND consumed_at IS NOT NULL
		LIMIT 1
	`, token).Scan(&family)
	if err != nil {
		return "", err
	}
	return family, nil
}

// DeleteSessionsByTokenFamily revokes every session (active and consumed) in a
// token family — used when a compromised refresh token is replayed.
func (c *PostgresClient) DeleteSessionsByTokenFamily(ctx context.Context, tokenFamily string) error {
	_, err := c.pool.Exec(ctx, `DELETE FROM sessions WHERE token_family = $1`, tokenFamily)
	return err
}

// DeleteSession deletes a session
func (c *PostgresClient) DeleteSession(ctx context.Context, id string) error {
	_, err := c.pool.Exec(ctx, `DELETE FROM sessions WHERE id = $1`, id)
	return err
}

// DeleteUserSessions deletes all sessions for a user
func (c *PostgresClient) DeleteUserSessions(ctx context.Context, userID string) error {
	_, err := c.pool.Exec(ctx, `DELETE FROM sessions WHERE user_id = $1`, userID)
	return err
}

// DeleteExpiredSessions deletes expired sessions plus consumed sessions older
// than one hour (consumed rows are retained briefly for reuse detection).
func (c *PostgresClient) DeleteExpiredSessions(ctx context.Context) (int64, error) {
	result, err := c.pool.Exec(ctx, `
		DELETE FROM sessions
		WHERE expires_at < NOW()
		   OR (consumed_at IS NOT NULL AND consumed_at < NOW() - INTERVAL '1 hour')
	`)
	if err != nil {
		return 0, err
	}
	return result.RowsAffected(), nil
}
