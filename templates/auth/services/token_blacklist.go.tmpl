package services

import (
	"context"
	"crypto/sha256"
	"encoding/hex"
	"sync"
	"time"
{{- if .HasCache}}

	"{{.ModuleName}}/internals/cache"
{{- end}}
)

// TokenBlacklist manages revoked tokens
// Uses in-memory storage with automatic expiration cleanup
type TokenBlacklist struct {
	tokens map[string]time.Time // token hash -> expiration time
	mu     sync.RWMutex
	stopCh chan struct{}
	doneCh chan struct{}
{{- if .HasCache}}
	cache  cache.Cache // optional shared cache for cross-replica revocation
{{- end}}
}

// BlacklistOption configures a TokenBlacklist.
type BlacklistOption func(*TokenBlacklist)

{{- if .HasCache}}

// WithBlacklistCache backs the blacklist with a shared cache so revocations are
// visible across replicas. In-memory storage remains as a local fallback.
func WithBlacklistCache(c cache.Cache) BlacklistOption {
	return func(tb *TokenBlacklist) { tb.cache = c }
}
{{- end}}

// NewTokenBlacklist creates a new token blacklist
func NewTokenBlacklist(opts ...BlacklistOption) *TokenBlacklist {
	tb := &TokenBlacklist{
		tokens: make(map[string]time.Time),
		stopCh: make(chan struct{}),
		doneCh: make(chan struct{}),
	}
	for _, opt := range opts {
		opt(tb)
	}

	// Start cleanup goroutine
	go tb.cleanup()

	return tb
}

{{- if .HasCache}}

// blacklistKey namespaces a token hash within the shared cache.
func blacklistKey(hash string) string { return "blacklist:" + hash }
{{- end}}

// Blacklist adds a token to the blacklist until its expiration
// ctx is accepted for interface compatibility with potential database-backed implementations
func (tb *TokenBlacklist) Blacklist({{if .HasCache}}ctx{{else}}_{{end}} context.Context, token string, expiresAt time.Time) error {
	// Don't blacklist already expired tokens
	if time.Now().After(expiresAt) {
		return nil
	}

	hash := hashToken(token)

{{- if .HasCache}}
	if tb.cache != nil {
		// Store until the token would expire so the cache self-evicts.
		return tb.cache.Set(ctx, blacklistKey(hash), []byte("1"), time.Until(expiresAt))
	}
{{- end}}

	tb.mu.Lock()
	tb.tokens[hash] = expiresAt
	tb.mu.Unlock()

	return nil
}

// IsBlacklisted checks if a token is blacklisted
// ctx is accepted for interface compatibility with potential database-backed implementations
func (tb *TokenBlacklist) IsBlacklisted({{if .HasCache}}ctx{{else}}_{{end}} context.Context, token string) bool {
	hash := hashToken(token)

{{- if .HasCache}}
	if tb.cache != nil {
		if ok, err := tb.cache.Exists(ctx, blacklistKey(hash)); err == nil {
			return ok
		}
		// On cache error, fall through to the in-memory view.
	}
{{- end}}

	tb.mu.RLock()
	expiresAt, exists := tb.tokens[hash]
	tb.mu.RUnlock()

	if !exists {
		return false
	}

	// Token in blacklist but expired - not blacklisted anymore
	if time.Now().After(expiresAt) {
		return false
	}

	return true
}

// Close stops the cleanup goroutine and waits for it to finish
func (tb *TokenBlacklist) Close() {
	close(tb.stopCh)
	<-tb.doneCh // Wait for cleanup goroutine to finish
}

// cleanup periodically removes expired tokens from the blacklist
func (tb *TokenBlacklist) cleanup() {
	defer close(tb.doneCh)

	ticker := time.NewTicker(5 * time.Minute)
	defer ticker.Stop()

	for {
		select {
		case <-ticker.C:
			tb.removeExpired()
		case <-tb.stopCh:
			return
		}
	}
}

// removeExpired removes all expired tokens from the blacklist
func (tb *TokenBlacklist) removeExpired() {
	now := time.Now()

	tb.mu.Lock()
	defer tb.mu.Unlock()

	for hash, expiresAt := range tb.tokens {
		if now.After(expiresAt) {
			delete(tb.tokens, hash)
		}
	}
}

// hashToken creates a SHA256 hash of the token for storage
// We don't store the actual token to minimize exposure
func hashToken(token string) string {
	hash := sha256.Sum256([]byte(token))
	return hex.EncodeToString(hash[:])
}
