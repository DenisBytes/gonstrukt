package config

import (
	"fmt"
	"os"
	"path/filepath"
	"regexp"

	"gopkg.in/yaml.v3"
)

var envVarRe = regexp.MustCompile(`\$\{([^}]+)\}`)

// expandEnv expands ${VAR} and ${VAR:-default} in s using os.Getenv.
func expandEnv(s string) string {
	return envVarRe.ReplaceAllStringFunc(s, func(match string) string {
		inner := match[2 : len(match)-1] // strip ${ and }
		name, defaultVal, hasDefault := "", "", false
		if idx := findDefault(inner); idx >= 0 {
			name = inner[:idx]
			defaultVal = inner[idx+2:]
			hasDefault = true
		} else {
			name = inner
		}
		if val := os.Getenv(name); val != "" {
			return val
		}
		if hasDefault {
			return defaultVal
		}
		return ""
	})
}

// findDefault returns the index of ":-" in s, or -1 if not found.
func findDefault(s string) int {
	for i := 0; i < len(s)-1; i++ {
		if s[i] == ':' && s[i+1] == '-' {
			return i
		}
	}
	return -1
}

// LoadYAML loads configuration from a YAML file
func LoadYAML[T any](path string) (*T, error) {
	// Expand environment variables in path
	path = os.ExpandEnv(path)

	// Make path absolute if relative
	if !filepath.IsAbs(path) {
		cwd, err := os.Getwd()
		if err != nil {
			return nil, fmt.Errorf("failed to get working directory: %w", err)
		}
		path = filepath.Join(cwd, path)
	}

	data, err := os.ReadFile(path)
	if err != nil {
		return nil, fmt.Errorf("failed to read config file %s: %w", path, err)
	}

	// Expand environment variables in content (supports ${VAR:-default} syntax)
	expandedData := expandEnv(string(data))

	var cfg T
	if err := yaml.Unmarshal([]byte(expandedData), &cfg); err != nil {
		return nil, fmt.Errorf("failed to parse config file %s: %w", path, err)
	}

	return &cfg, nil
}

// SaveYAML saves configuration to a YAML file
func SaveYAML[T any](path string, cfg *T) error {
	data, err := yaml.Marshal(cfg)
	if err != nil {
		return fmt.Errorf("failed to marshal config: %w", err)
	}

	// Ensure directory exists
	dir := filepath.Dir(path)
	if err := os.MkdirAll(dir, 0755); err != nil {
		return fmt.Errorf("failed to create config directory: %w", err)
	}

	if err := os.WriteFile(path, data, 0644); err != nil {
		return fmt.Errorf("failed to write config file: %w", err)
	}

	return nil
}
